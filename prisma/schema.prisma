generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  price       Int
  compareAt   Int?
  images      String
  sizes       String
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  fullName       String
  mobile         String
  email          String?
  altPhone       String?
  pincode        String
  state          String
  city           String
  addressLine1   String
  addressLine2   String?
  landmark       String?
  paymentMethod  String
  paidAmount     Int
  codAmount      Int
  totalAmount    Int
  discountAmount Int         @default(0)
  paymentStatus  String      @default("PENDING")
  orderStatus    String      @default("PLACED")
  utr            String?
  notes          String?
  metaFbc        String?
  metaFbp        String?
  utmData        String?
  capiFired      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]

  @@index([mobile])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([paymentMethod])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  size        String
  quantity    Int
  price       Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
}

model VerificationSession {
  id        String   @id @default(cuid())
  token     String   @unique
  mobile    String
  captcha   String
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model AdminLog {
  id        String   @id @default(cuid())
  action    String
  metadata  String?
  createdAt DateTime @default(now())
}

model Waitlist {
  id          String   @id @default(cuid())
  productId   String
  productName String
  size        String
  mobile      String
  email       String?
  notified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([productId, size])
  @@index([notified])
}

model BlockedPincode {
  id        String   @id @default(cuid())
  pincode   String   @unique
  reason    String
  createdAt DateTime @default(now())
}

model Review {
  id          String   @id @default(cuid())
  productSlug String
  orderId     String?
  rating      Int
  name        String
  city        String?
  title       String
  body        String
  photos      String
  size        String?
  verified    Boolean  @default(false)
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([productSlug])
  @@index([approved])
  @@index([createdAt])
}

model Referral {
  id            String   @id @default(cuid())
  code          String   @unique
  referrerName  String
  referrerEmail String?
  referrerPhone String?
  invitesUsed   Int      @default(0)
  creditsEarned Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([code])
}

model LoyaltyPoints {
  id          String   @id @default(cuid())
  customerId  String   @unique
  points      Int      @default(0)
  totalSpent  Int      @default(0)
  totalOrders Int      @default(0)
  tier        String   @default("bronze")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
  @@index([tier])
}

// ================================================================
// v35: Add this Lead model to your prisma/schema.prisma
// Then run: npx prisma db push (with Neon URL set)
// ================================================================

model Lead {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Progressive contact info
  name          String?
  phone         String?
  email         String?

  // Geo signals
  city          String?
  pincode       String?
  state         String?
  addressLine1  String?
  region        String?
  country       String?
  timezone      String?
  language      String?

  // Device signals
  deviceType    String?  // mobile / desktop / tablet
  screenWidth   Int?
  screenHeight  Int?
  userAgent     String?  @db.Text

  // Traffic source
  landingUrl    String?  @db.Text
  referrer      String?  @db.Text
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmTerm       String?
  utmContent    String?

  // Engagement signals
  visitCount    Int      @default(1)
  isReturning   Boolean  @default(false)
  hasAddress    Boolean  @default(false)
  timeOnSite    Int?     // seconds
  pagesViewed   Int      @default(1)
  scrolled      Boolean  @default(false)

  // Discount
  optedIn       Boolean  @default(false)   // clicked Yes on chip
  chipDismissed Boolean  @default(false)   // clicked No
  couponCode    String?
  couponPct     Int?
  segment       String?  // real_intent / returning_vip / browser / bounce_risk / coupon_hunter

  // Cart signals
  cartAdded     Boolean  @default(false)
  cartValue     Int?
  cartSummary   String?  @db.Text
  cartAbandoned Boolean  @default(false)

  // Purchase link (if converted)
  orderNumber   String?
  converted     Boolean  @default(false)

  // Admin ops
  status        String   @default("new") // new / contacted / converted / lost / spam
  notes         String?  @db.Text

  @@index([createdAt])
  @@index([status])
  @@index([email])
  @@index([phone])
  @@index([converted])
  @@index([utmCampaign])
}