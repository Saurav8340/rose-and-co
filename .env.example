# ============================================================
# ROSÉ & CO — Environment Variables
# ============================================================

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Rosé & Co"

# Database (SQLite for MVP; swap to Postgres for prod)
DATABASE_URL="file:./dev.db"

# UPI (manual verification flow)
NEXT_PUBLIC_UPI_ID="8340474678@pthdfc"
NEXT_PUBLIC_UPI_PAYEE_NAME="Rose And Co"

# Admin (login: /admin/login)
ADMIN_EMAIL="admin@roseandco.in"
ADMIN_PASSWORD="ChangeThisStrongPass@2026"
SESSION_SECRET="replace-with-64-char-random-string-generate-with-openssl-rand-hex-32"

# Cron secret (for Vercel Cron / stale order cleanup)
CRON_SECRET="another-random-32-char-string"

# ============================================================
# META PIXEL & CAPI (paid-orders-only optimization)
# ============================================================
# Client-side Pixel — only PageView fires, and only on non-admin routes
NEXT_PUBLIC_META_PIXEL_ID=""

# Server-side Conversions API — Purchase fires ONLY when:
#   - PREPAID + paymentStatus VERIFIED, OR
#   - PARTIAL_COD + orderStatus DELIVERED + paymentStatus VERIFIED
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
META_TEST_EVENT_CODE=""

# Optional GA4/GTM
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GTM_ID=""
